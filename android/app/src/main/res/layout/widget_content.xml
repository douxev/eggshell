<?xml version="1.0" encoding="utf-8"?>
<!--
    The layout every content-bearing module widget uses.

    One shape for all of them — icon, module name, « + », and up to four rows of
    title + one line — because that is genuinely all they have in common and all
    a home-screen card has room for. Traitements keeps a layout of its own: its
    rows carry two action buttons, which nothing else does.

    Everything drawn here comes from WidgetContentMirror, written only for a
    widget its owner explicitly turned on, never in paranoid mode, and emptied
    the moment the vault locks. So these rows are blank most of the time by
    design: no opt-in, or the app locked. The empty line carries the
    explanation, and it is deliberately generic — "locked" says the app is shut,
    not what is inside it.

    Plain LinearLayout/TextView only: RemoteViews supports a limited widget set
    and this inflates identically across launchers. The root carries no click
    handler, because several launchers collapse child taps into the parent's
    PendingIntent when the parent has one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/content_widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_module_notes"/>

        <TextView
            android:id="@+id/content_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/content_widget_action_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/content_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"/>

    <LinearLayout
        android:id="@+id/content_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/content_title_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/content_preview_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/content_title_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/content_preview_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/content_title_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/content_preview_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/content_title_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/content_preview_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
