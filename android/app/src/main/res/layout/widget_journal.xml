<?xml version="1.0" encoding="utf-8"?>
<!--
    The Journal widget: the latest entry's gauges, drawn as bars.

    Not a list of dates. What someone glances at their home screen to know is
    how they were doing at their last check-in, and the journal answers that
    with gauges, so the widget shows the same gauges — one row per metric the
    entry carries, label on the left, the bar in the middle, the value on the
    right, in the colour the app gives that metric. Under it, the week: how
    many entries in the last seven days and the average mood.

    Never the free text. A journal entry's prose is the most private thing in
    this app and has no business on a home screen, opt-in or not.

    Six rows because that is what the five built-in gauges plus one custom
    indicator need; the provider hides what the entry does not carry. Colours
    reference @color/widget_* and are painted over per theme at render time
    (WidgetPalette). Plain LinearLayout/TextView/ProgressBar only, and no click
    handler on the root — see widget_content.xml for both reasons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/journal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/journal_widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_module_journal"/>

        <TextView
            android:id="@+id/journal_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/journal_widget_action_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/journal_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"/>

    <!-- When the entry was written: "il y a 2 h · 08:30". The tap target for
         the whole entry block, since the gauge rows are not clickable. -->
    <TextView
        android:id="@+id/journal_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="1"
        android:textColor="@color/widget_on_bg"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:id="@+id/journal_gauge_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/journal_label_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/journal_bar_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:max="10"
            android:progressDrawable="@drawable/widget_gauge"/>

        <TextView
            android:id="@+id/journal_value_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="18dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/journal_gauge_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/journal_label_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/journal_bar_2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:max="10"
            android:progressDrawable="@drawable/widget_gauge"/>

        <TextView
            android:id="@+id/journal_value_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="18dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/journal_gauge_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/journal_label_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/journal_bar_3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:max="10"
            android:progressDrawable="@drawable/widget_gauge"/>

        <TextView
            android:id="@+id/journal_value_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="18dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/journal_gauge_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/journal_label_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/journal_bar_4"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:max="10"
            android:progressDrawable="@drawable/widget_gauge"/>

        <TextView
            android:id="@+id/journal_value_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="18dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/journal_gauge_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/journal_label_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/journal_bar_5"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:max="10"
            android:progressDrawable="@drawable/widget_gauge"/>

        <TextView
            android:id="@+id/journal_value_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="18dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/journal_gauge_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/journal_label_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>

        <ProgressBar
            android:id="@+id/journal_bar_6"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:max="10"
            android:progressDrawable="@drawable/widget_gauge"/>

        <TextView
            android:id="@+id/journal_value_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="18dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- The week: "4 entrées sur 7 j · humeur moy. 6,2". -->
    <TextView
        android:id="@+id/journal_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"/>
</LinearLayout>
