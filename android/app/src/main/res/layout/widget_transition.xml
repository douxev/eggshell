<?xml version="1.0" encoding="utf-8"?>
<!--
    Transition home-screen widget.

    Up to three upcoming reminders, then two action pills (open the app and
    log a feeling). Kept deliberately simple — no Space + weight, no
    letterSpacing — so RemoteViews inflates the same way on every launcher.

    Reminder rows are pre-allocated and just hidden when the provider has
    fewer than three reminders to render. We avoid RemoteViewsService here
    because the widget would have to bind to a foreground service that
    needs the vault unlocked, and the static three-row design is enough
    for the at-a-glance use case.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="@string/widget_eyebrow"
        android:textColor="@color/widget_accent"
        android:textSize="10sp"
        android:textStyle="bold"/>

    <!-- Reminder row #1 -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="14sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_when_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Reminder row #2 -->
    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/widget_when_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Reminder row #3 -->
    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"/>
        <TextView
            android:id="@+id/widget_when_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Fallback / empty-state copy. Only one of (rows, empty) is shown. -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_default_subtitle"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Action bar: Open + Note (journal).

         Each pill is a TextView at 48dp touch height — anything smaller is
         below the Material spec minimum and causes legitimate "couldn't
         tap that" reports. gravity=center centres the text inside the
         enlarged hit-box without affecting the visible pill.

         The buttons get their PendingIntents directly. The root view does
         NOT get one any more: several launcher implementations (AOSP +
         Pixel Launcher amongst them) collapse all child clicks into the
         parent's PendingIntent, which would mean "Noter" silently fires
         the "open app" intent. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_action_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="80dp"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/widget_action_open"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_action_journal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="80dp"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/widget_action_journal"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
