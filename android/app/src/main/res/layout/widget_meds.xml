<?xml version="1.0" encoding="utf-8"?>
<!--
    The Traitements widget: the next doses due, and the two taps that record one.

    Unlike every other module widget this one holds real data, and it is allowed
    to because the data is not the vault's. It reads the off-vault reminder
    mirror (ReminderPrefs) that already exists so alarms can fire while the app
    is locked, and it shows exactly what the notification for the same dose
    already shows — same opt-in label rules, nothing new in the clear. That is
    why it works in every security mode, paranoid included.

    Two actions per row rather than one:
      ✔  records the dose now, the same broadcast the notification's « Pris »
         sends, so it works with the vault shut (queued, folded in on unlock).
      🕐 asks what time it was actually taken first. Someone who took their dose
         at 8h and reaches their phone at 14h was otherwise recording 14h, and a
         wrong timestamp is invisible: it looks exactly like a right one, while
         quietly corrupting the punctuality history the log exists for.

    Plain LinearLayout/TextView only — RemoteViews supports a limited widget set
    and this inflates identically across launchers. The root carries no click
    handler, for the reason widget_module.xml documents: several launchers
    collapse child taps into the parent's PendingIntent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meds_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/meds_widget_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_module_meds"/>

        <TextView
            android:id="@+id/meds_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="1"
            android:textColor="@color/widget_on_bg"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/meds_widget_action_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Shown when there is nothing due, and when the widget is not allowed to
         say (decoy). The decoy case sets it to empty rather than to an
         explanation: naming the module to excuse the blank is the leak. -->
    <TextView
        android:id="@+id/meds_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"/>

    <!-- Row 1. Title + due time on the left, the two actions on the right.
         Each action is its own click target with its own PendingIntent: a row
         that only opened the app would be one more thing to do later, which is
         precisely the friction that makes a dose get logged at the wrong time
         or not at all. -->
    <LinearLayout
        android:id="@+id/meds_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/meds_row_body_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meds_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_bg"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/meds_when_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/meds_taken_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/meds_taken_at_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Row 2. Title + due time on the left, the two actions on the right.
         Each action is its own click target with its own PendingIntent: a row
         that only opened the app would be one more thing to do later, which is
         precisely the friction that makes a dose get logged at the wrong time
         or not at all. -->
    <LinearLayout
        android:id="@+id/meds_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/meds_row_body_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meds_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_bg"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/meds_when_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/meds_taken_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/meds_taken_at_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Row 3. Title + due time on the left, the two actions on the right.
         Each action is its own click target with its own PendingIntent: a row
         that only opened the app would be one more thing to do later, which is
         precisely the friction that makes a dose get logged at the wrong time
         or not at all. -->
    <LinearLayout
        android:id="@+id/meds_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/meds_row_body_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meds_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_on_bg"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/meds_when_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/meds_taken_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_action_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_accent"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/meds_taken_at_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:textColor="@color/widget_on_bg"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
