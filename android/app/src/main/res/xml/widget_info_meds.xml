<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget for the "Médics" module.

    Unlike its eight siblings this one shows data, so it differs from them in
    three ways:

    - A real android:configure. The warning the other widget_info files carry is
      about an *empty* configure attribute, which crashes the launcher on first
      add; a declared activity is fine, and per-instance configuration is what
      lets two Traitements widgets watch different things.
    - A taller default cell: three dose rows with two action buttons each do not
      fit in the 2x2 the door widgets use.
    - Still updatePeriodMillis=0. The relative labels it draws ("in 2 h") do go
      stale on their own, but polling would wake the device on a fixed cadence
      forever to fix a cosmetic drift. Everything that actually changes the
      content — a dose logged, a schedule edited, an alarm firing, a lock —
      pushes a repaint through WidgetRefresh instead.

    No android:previewLayout, as before: one the launcher can't rasterise can
    crash the picker, and the system default preview is the safe choice.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_meds"
    android:configure="com.douxev.eggshell.widget.WidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/meds_widget_description"/>
