    <string name="unlock_recovery_submit">Déverrouiller</string>
    <string name="unlock_recovery_back">Revenir à l\'empreinte</string>
    <string name="unlock_recovery_keystore_dead">Ton empreinte ne peut plus ouvrir le coffre sur ce téléphone : Android a invalidé la clé, souvent après l\'ajout d\'une empreinte ou une mise à jour du système. Tes données sont intactes — utilise ta clé de secours.</string>
