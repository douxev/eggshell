    <!-- ============ What’s new ============ -->
    <string name="set_wn_title">What’s new</string>
    <string name="set_wn_1_title">A single home</string>
    <string name="set_wn_1_sub">No more tab bar: your eight modules fit on home, and back always brings you there.</string>
    <string name="set_wn_2_title">Tick a dose without navigating</string>
    <string name="set_wn_2_sub">The next dose and today’s mood are logged from home, in one gesture.</string>
    <string name="set_wn_3_title">Readable regularity</string>
    <string name="set_wn_3_sub">A chart shows how far each dose landed from its planned time, and never invents a number.</string>
    <string name="set_wn_4_title">Settings in three doors</string>
    <string name="set_wn_4_sub">Modules, Security, Appearance &amp; language. Reminders move up a level.</string>
    <string name="set_wn_5_title">The doctor report travels with you</string>
    <string name="set_wn_5_sub">You prepare it from Appointments, with the periods and sections you choose.</string>
    <string name="set_wn_6_title">Finer lab imports</string>
    <string name="set_wn_6_sub">Reading a PDF now keeps the lab name too, so your doctor knows where a value came from.</string>

    <!-- ============ Resources ============ -->
    <string name="set_resources_intro">Websites, helplines and associations. The link opens in your browser — nothing goes through eggshell.</string>

    <string name="set_res_fransgenre">French-speaking community platform: personal accounts, a knowledge base, lists of trans-friendly practitioners, a mutual-aid forum.</string>
    <string name="set_res_administrans">Collaborative guide to trans paperwork in France: name change, gender marker, ID documents, health cover.</string>
    <string name="set_res_wikitrans">Collaborative French-language encyclopedia on trans matters: protocols, paperwork, local resources.</string>
    <string name="set_res_transat_dir_title">Transat (directory)</string>
    <string name="set_res_transat_dir">Directory of trans-friendly doctors, endocrinologists and practitioners across France.</string>
