    <!-- ===== Nature of this document ===== -->
    <string name="pdfdoc_disclaimer_lead">Nature of this document.</string>
    <string name="pdfdoc_disclaimer_body">All data is entered by the person concerned in a personal application; it is neither verified nor timestamped by a third party. Laboratory results are copied out or read automatically from the laboratory reports, the originals of which are authoritative. This document is an aid to the consultation; it replaces neither a clinical examination nor a laboratory report.</string>

