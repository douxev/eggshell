    <string name="onboarding_title">Initial setup</string>
    <string name="onboarding_welcome_title">Welcome</string>
    <string name="onboarding_welcome_body">All your data stays on your phone, encrypted locally. Nothing is sent to a server. You\'re about to pick how the app should be locked.</string>
    <string name="onboarding_pick_mode_title">Security mode</string>
    <string name="onboarding_pick_mode_body">You can change this later from the settings.</string>
    <string name="security_mode_encryption_note">Your data is always encrypted on your device. The mode you pick only changes how you unlock the app day-to-day.</string>
    <string name="onboarding_creating">Creating encrypted vault…</string>
    <string name="onboarding_error_prefix">Error: %1$s</string>

    <string name="mode_keystore_only_title">No code</string>
    <string name="mode_keystore_only_body">The phone stores the key in its secure module. No password to type, the app opens instantly. Whoever unlocks your phone can open the app.</string>
    <string name="mode_keystore_biometric_title">Biometric</string>
    <string name="mode_keystore_biometric_body">You confirm with your fingerprint or face each time. The key stays protected by the phone\'s secure module. Good balance of security and ergonomics.</string>
    <string name="mode_keystore_passphrase_title">Password</string>
    <string name="mode_keystore_passphrase_body">Two-factor: you need both the password AND the phone (the key is protected by the secure module). Recommended if you worry about physical access to the device.</string>
    <string name="mode_paranoid_title">Paranoid mode</string>
    <string name="mode_paranoid_body">Password only, no help from the secure module. No key is persisted: the password re-derives the key on every cold start. Maximum friction, maximum protection (resists an attacker who compromised the secure enclave).</string>

    <!-- One-line "is this for me?" pitch shown under each mode. -->
