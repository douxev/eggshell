<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications and exact alarms (Phase 2) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <!-- Security (Phase 1) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- Media (Phase 5) -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:name=".EggshellApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eggshell"
        tools:targetApi="34">

        <!-- Required by AppCompatDelegate.setApplicationLocales to persist
             the chosen language on Android <13. On Android 13+ the platform
             handles persistence; the meta-data here makes AppCompat skip its
             own backup store when the platform takes over. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true"/>
        </service>

        <!-- File sharing for backup + PDF export. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths"/>
        </provider>

        <!-- Phase 2: medication reminders. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false"/>
        <receiver
            android:name=".reminders.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <!-- We deliberately do NOT listen for LOCKED_BOOT_COMPLETED:
                 the receiver isn't directBootAware, ReminderPrefs / Hilt
                 require Credential-Encrypted storage, and the alarm
                 reschedule we'd attempt before user unlock would crash
                 silently. BOOT_COMPLETED fires once the user unlocks and
                 storage is available, which is what we need. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Default activity, disabled at runtime once the user picks an alternative alias -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Eggshell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Activity aliases for the masking feature (Phase 7).
             Each alias points back to MainActivity but advertises a different
             label + icon. PackageManager.setComponentEnabledSetting toggles
             which one shows up in the launcher. -->
        <activity-alias
            android:name=".alias.NotesAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes"
            android:roundIcon="@mipmap/ic_launcher_notes_round"
            android:label="@string/alias_notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.CalculatorAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator"
            android:roundIcon="@mipmap/ic_launcher_calculator_round"
            android:label="@string/alias_calculator"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.WeatherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_weather"
            android:roundIcon="@mipmap/ic_launcher_weather_round"
            android:label="@string/alias_weather"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widget showing the next dose and next reminder.
             The APPWIDGET_UPDATE filter must be exported so the system's
             AppWidgetService can deliver re-render events. We deliberately
             do NOT advertise our custom REFRESH action here — internal
             re-renders go through AppWidgetManager.updateAppWidget directly
             (no broadcast), so an external `am broadcast` can't force a
             render that would read LabReminderPrefs and surface lab labels
             on the home screen. -->
        <receiver
            android:name=".widget.EggshellWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info"/>
        </receiver>

    </application>

</manifest>
