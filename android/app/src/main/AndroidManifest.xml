<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notifications and exact alarms (Phase 2) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <!-- Security (Phase 1) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- Media (Phase 5) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Step counting for the Sport module. Requested only when the user turns
         the pedometer on, never at install: an app that asks for a body-sensor
         permission nobody enabled is exactly the surprise this one should not
         spring. What the sensor produces goes to the encrypted vault, by way
         of a sealed off-vault ledger while the vault is shut (StepLedger). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

    <!-- Heart-rate sensors over the standard Bluetooth profile — how a watch is
         integrated here without Wear OS and without Google Play Services.
         Requested only when the user asks to connect one.

         neverForLocation on the scan: a BLE scan can be used to infer where
         someone is, which is why Android ties it to location by default. This
         app scans for exactly one service UUID and derives nothing about
         position, and the flag is what says so to the system rather than
         quietly holding a location capability. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Pre-Android-12 only: back then a BLE scan required a location
         permission outright. maxSdkVersion so newer installs never see it. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"/>

    <!-- Health Connect, read-only, and only these four record types: the Sport
         module's workouts, daily steps, and the heart rate and distance that
         complete a workout. No routes, no background read, no history beyond
         what Health Connect serves by default, and no write permission at all.
         Requested only when the user turns the import on, never at install
         (see data/health/HealthConnectSync, whose PERMISSIONS must match). -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_DISTANCE"/>

    <!--
      Without this, queryIntentServices() for RecognitionService returns an
      empty list on API 30+ and the app cannot see a single third-party
      transcription engine the user has installed. It is not an error and there
      is no warning: the picker is simply empty, with nothing to explain why.
      Declares an intent, not a package — no app is named.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Health Connect is an app on Android 13 and older; without this
             the client cannot see it is installed and reports it missing. -->
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>

    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- required=false: a phone with no step counter installs and runs fine,
         it simply cannot offer the pedometer. -->
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false"/>
    <!-- required=false: a phone with no BLE installs and runs fine, it simply
         cannot connect a heart-rate sensor. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>

    <application
        android:name=".EggshellApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eggshell"
        tools:targetApi="34">

        <!-- Required by AppCompatDelegate.setApplicationLocales to persist
             the chosen language on Android <13. On Android 13+ the platform
             handles persistence; the meta-data here makes AppCompat skip its
             own backup store when the platform takes over. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true"/>
        </service>

        <!-- File sharing for backup + PDF export. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths"/>
        </provider>

        <!-- Phase 2: medication reminders. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false"/>
        <receiver
            android:name=".reminders.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <!-- We deliberately do NOT listen for LOCKED_BOOT_COMPLETED:
                 the receiver isn't directBootAware, ReminderPrefs / Hilt
                 require Credential-Encrypted storage, and the alarm
                 reschedule we'd attempt before user unlock would crash
                 silently. BOOT_COMPLETED fires once the user unlocks and
                 storage is available, which is what we need. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- The pedometer's fixed reading points: 23:59 (its own alarm), shutdown
             (the counter restarts at zero on boot, so anything unread is lost),
             and the events that invalidate the 23:59 alarm. Disabled until the
             pedometer is switched on (StepSync toggles it), so an app that does
             not count steps is not woken at every shutdown. See data/StepSync.kt. -->
        <receiver
            android:name=".data.StepReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_SHUTDOWN"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>

        <!-- Default activity, disabled at runtime once the user picks an alternative alias -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Eggshell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Activity aliases for the masking feature (Phase 7).
             Each alias points back to MainActivity but advertises a different
             label + icon. PackageManager.setComponentEnabledSetting toggles
             which one shows up in the launcher. -->
        <!-- The widget\'s "taken at…" picker. Not exported: only our own
             PendingIntent starts it, and an exported dialog that records a dose
             is an action any installed app could trigger.

             showWhenLocked so it can be answered without unlocking the phone —
             it needs no vault (ReminderReceiver queues the dose when the vault
             is shut), and requiring an unlock first is exactly the friction
             that makes the dose get logged at the wrong time. excludeFromRecents
             so a screenshot of the task list never carries it. -->
        <activity
            android:name=".widget.DoseTimeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Eggshell.Transparent"/>

        <!-- Widget configuration, for every module widget.
             exported="true" is required: the launcher, a different app, starts
             it via ACTION_APPWIDGET_CONFIGURE. It reads and writes only the row
             of the widget being placed. When the vault is open it lists what a
             widget can follow — note titles and folders, medication names — so
             it runs under FLAG_SECURE; with the vault shut it shows none of it
             and keeps whatever was chosen before. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Eggshell.Transparent">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>

        <!-- What is read from Health Connect, and why. Health Connect opens it
             itself: from its permission dialog through
             ACTION_SHOW_PERMISSIONS_RATIONALE (Android 13 and older), and from
             its app settings through the VIEW_PERMISSION_USAGE alias below
             (Android 14 and newer), which only the system may start — hence
             START_VIEW_PERMISSION_USAGE on it.

             Its own activity rather than MainActivity: MainActivity is
             disabled while a disguise alias is active, and a link pointing at
             it would open nothing. Exported because Health Connect is another
             app; it shows fixed text and nothing from the vault. -->
        <activity
            android:name=".ui.health.HealthConnectRationaleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Eggshell">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ui.health.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.health.HealthConnectRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.NotesAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes"
            android:roundIcon="@mipmap/ic_launcher_notes_round"
            android:label="@string/alias_notes"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.CalculatorAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator"
            android:roundIcon="@mipmap/ic_launcher_calculator_round"
            android:label="@string/alias_calculator"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".alias.WeatherAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_weather"
            android:roundIcon="@mipmap/ic_launcher_weather_round"
            android:label="@string/alias_weather"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widget showing the next dose and next reminder.
             The APPWIDGET_UPDATE filter must be exported so the system's
             AppWidgetService can deliver re-render events. We deliberately
             do NOT advertise our custom REFRESH action here — internal
             re-renders go through AppWidgetManager.updateAppWidget directly
             (no broadcast), so an external `am broadcast` can't force a
             render that would read LabReminderPrefs and surface lab labels
             on the home screen. -->
        <receiver
            android:name=".widget.EggshellWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info"/>
        </receiver>


        <!-- Per-module widgets. Each is a door into one module — name, icon
             and a way in — until its owner turns its content on, widget by
             widget, from the configuration activity (see ModuleWidgetProvider
             and ContentWidgetProvider for the two routes that content takes).

             Traitements and Analyses read the off-vault reminder mirrors that
             already exist so alarms can fire while the app is locked, and show
             what those notifications already show; they need no opt-in. Poids
             has no widget.

             All ten are disabled as a set by WidgetVisibility while a decoy
             PIN is configured, which pulls them out of the launcher's widget
             picker. Leaving them listed would let anyone holding the phone read
             off the app's module structure from the picker alone — the same
             disclosure the decoy exists to prevent, reached without ever
             touching the PIN prompt. -->

        <receiver
            android:name=".widget.MedsWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_meds">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_meds"/>
        </receiver>

        <receiver
            android:name=".widget.JournalWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_journal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_journal"/>
        </receiver>

        <receiver
            android:name=".widget.LabsWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_labs">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_labs"/>
        </receiver>

        <receiver
            android:name=".widget.AppointmentsWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_appointments">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_appointments"/>
        </receiver>

        <receiver
            android:name=".widget.SportWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_sport">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_sport"/>
        </receiver>

        <receiver
            android:name=".widget.DreamsWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_dreams">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_dreams"/>
        </receiver>

        <receiver
            android:name=".widget.NotesWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_notes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_notes"/>
        </receiver>

        <receiver
            android:name=".widget.BleedingWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_bleeding">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_bleeding"/>
        </receiver>

        <receiver
            android:name=".widget.PhotosWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_photos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_photos"/>
        </receiver>

        <receiver
            android:name=".widget.VoiceWidgetProvider"
            android:exported="true"
            android:label="@string/module_widget_label_voice">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_voice"/>
        </receiver>

    </application>

</manifest>
