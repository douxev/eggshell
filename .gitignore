# Rust
core/target/
**/*.rs.bk
Cargo.lock.bak

# Android / Gradle
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.idea/
android/*.iml
android/app/*.iml

# Native libs are generated by cargo-ndk into jniLibs/
android/app/src/main/jniLibs/

# Generated UniFFI Kotlin bindings
android/app/build/generated/uniffi/

# OS / editor
.DS_Store
*~
.vscode/
*.log

# Design handoff bundle — kept local, not published
design/

# Release signing — keystores and passphrases must never be committed.
# Losing them == losing the ability to publish updates for
# com.douxev.eggshell forever; leaking them == anyone can sign a forged
# "update" with your cert.
keystores/
*.jks
*.keystore
keystore.properties
