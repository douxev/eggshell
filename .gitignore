# Design handoff bundle — kept local, not published
design/

# Release signing — keystores and passphrases must never be committed.
# Losing them == losing the ability to publish updates for
# com.douxev.eggshell forever; leaking them == anyone can sign a forged
# "update" with your cert.
keystores/
*.jks
*.keystore
keystore.properties

# Apple / iOS — generated build artifacts (rebuilt by apple/build-ios.sh + CI)
apple/TransitionCore/TransitionCoreFFI.xcframework/
apple/TransitionCore/Sources/TransitionCore/transition*.swift
apple/Eggshell/Eggshell.xcodeproj/
apple/.bindings/
apple/.headers/
# fastlane / build outputs
apple/build/
apple/fastlane/report.xml
apple/fastlane/Preview.html
apple/fastlane/test_output/
apple/fastlane/README.md
apple/vendor/
apple/.bundle/
*.ipa
*.dSYM.zip
*.mobileprovision
*.p12
*.p8

# Local release artifacts (apk/aab)
/dist/

