namespace transition {
    string hello(string name);

    // Generate OWASP-recommended Argon2id parameters with a fresh random salt.
    // The native side stores this alongside the wrapped key blob so unlock
    // can re-derive the KEK.
    FreshKdfMaterial fresh_kdf_material();

    // Cheap key validation that does not open the full DB. Use during unlock
    // before swapping out any persisted state.
    [Throws=TransitionError]
    void vault_verify_key(string db_path, VaultKey key);

    // Standard injection sites known to the rotation algorithm. Returned as
    // their canonical snake_case identifiers (the UI maps them to labels).
    sequence<string> standard_injection_sites();

    // Hormone unit conversion. Returns null when no conversion is defined.
    double? convert_hormone_value(double value, string from_unit, string to_unit, string hormone);

    // Restore a vault from an exported `.transition.enc` bundle. Returns the
    // 32-byte master key embedded in the bundle so the native side can
    // re-wrap it under the local Keystore (otherwise the previous
    // wrapped_key would no longer match the restored DB and unlock would
    // fail with "file is not in database").
    [Throws=TransitionError]
    ImportedVault import_encrypted(bytes bundle, string passphrase, string target_db_path);
};

[Error]
enum TransitionError {
    "Unimplemented",
    "Crypto",
    "Database",
    "Migration",
    "WrongKey",
    "VaultBusy",
};

dictionary ImportedVault {
    bytes master_key;
};

dictionary FreshKdfMaterial {
    bytes salt;
    u32 m_cost_kib;
    u32 t_cost;
    u32 p_cost;
};

// -- Medication --------------------------------------------------------------

dictionary Medication {
    i64 id;
    string name;
    string kind;
    string route;
    f64? default_dose;
    string? default_dose_unit;
    i64? color;
    string? notes;
    boolean archived;
    i64 created_at_ms;
};

dictionary NewMedication {
    string name;
    string kind;
    string route;
    f64? default_dose;
    string? default_dose_unit;
    i64? color;
    string? notes;
};

dictionary DoseEvent {
    i64 id;
    i64 medication_id;
    i64 taken_at_ms;
    f64? dose;
    string? dose_unit;
    string? route;
    string? injection_site;
    string? notes;
    string status;
    i64? scheduled_at_ms;
    i64? schedule_id;
};

dictionary NewDoseEvent {
    i64 medication_id;
    i64 taken_at_ms;
    f64? dose;
    string? dose_unit;
    string? route;
    string? injection_site;
    string? notes;
    // Defaulted so existing "log a taken dose" call sites need no change.
    string status = "taken";
    i64? scheduled_at_ms = null;
    i64? schedule_id = null;
};

dictionary TreatmentChange {
    i64 id;
    i64 medication_id;
    i64 at_ms;
    string field;
    string? old_value;
    string? new_value;
    string? note;
};

dictionary NewTreatmentChange {
    i64 medication_id;
    i64 at_ms;
    string field;
    string? old_value;
    string? new_value;
    string? note;
};

// -- VaultKey ----------------------------------------------------------------

interface VaultKey {
    [Name=random]
    constructor();

    [Name=from_raw, Throws=TransitionError]
    constructor(bytes raw);

    [Name=derive_from_passphrase, Throws=TransitionError]
    constructor(string passphrase, bytes salt, u32 m_cost_kib, u32 t_cost, u32 p_cost);

    [Name=unwrap_with_passphrase, Throws=TransitionError]
    constructor(bytes wrapped, string passphrase, bytes salt, u32 m_cost_kib, u32 t_cost, u32 p_cost);

    bytes export_raw();

    [Throws=TransitionError]
    bytes wrap_with_passphrase(string passphrase, bytes salt, u32 m_cost_kib, u32 t_cost, u32 p_cost);
};

// -- Vault -------------------------------------------------------------------

interface Vault {
    [Throws=TransitionError]
    constructor(string db_path, VaultKey key);

    [Throws=TransitionError]
    u32 schema_version();

    // Medication CRUD
    [Throws=TransitionError]
    Medication add_medication(NewMedication med, i64 now_ms);

    [Throws=TransitionError]
    Medication? get_medication(i64 id);

    [Throws=TransitionError]
    sequence<Medication> list_medications(boolean include_archived);

    [Throws=TransitionError]
    void set_medication_archived(i64 id, boolean archived);

    [Throws=TransitionError]
    void update_medication(i64 id, NewMedication med);

    // Hard-delete a medication; cascades its dose history, schedules and
    // treatment changes. Off-vault alarms/prefs are the native side's job.
    [Throws=TransitionError]
    void delete_medication(i64 id);

    // Treatment-change audit (dose/route edits over time)
    [Throws=TransitionError]
    TreatmentChange log_treatment_change(NewTreatmentChange change);

    [Throws=TransitionError]
    sequence<TreatmentChange> list_treatment_changes(i64 from_ms, i64 to_ms);

    // Dose log
    [Throws=TransitionError]
    DoseEvent log_dose(NewDoseEvent dose);

    // Batch insert in one transaction — "log a date range" (e.g. a daily
    // topical declared for several months in one go).
    [Throws=TransitionError]
    sequence<DoseEvent> log_doses(sequence<NewDoseEvent> doses);

    // Overwrite a recorded dose in place (fix route/date/amount after the
    // fact). The id stays stable.
    [Throws=TransitionError]
    DoseEvent update_dose(i64 id, NewDoseEvent dose);

    [Throws=TransitionError]
    DoseEvent? get_dose(i64 id);

    [Throws=TransitionError]
    sequence<DoseEvent> list_doses(i64 medication_id, i64 offset, i64 limit);

    // All dose events across meds in a time window (for the correlation view).
    [Throws=TransitionError]
    sequence<DoseEvent> list_dose_events_between(i64 from_ms, i64 to_ms);

    // Delete a single recorded dose by id.
    [Throws=TransitionError]
    void delete_dose(i64 id);

    [Throws=TransitionError]
    string? suggest_next_injection_site(i64 medication_id, i64 history_depth);

    // Schedules
    [Throws=TransitionError]
    DoseSchedule add_schedule(NewDoseSchedule schedule, i64 now_ms);

    [Throws=TransitionError]
    sequence<DoseSchedule> list_active_schedules();

    [Throws=TransitionError]
    sequence<DoseSchedule> list_schedules_for_medication(i64 medication_id, boolean include_inactive);

    // Edit a reminder in place — id stays stable so armed alarms and sealed
    // prefs keep pointing at the same schedule. `active`/`created_at_ms`
    // are untouched; medication_id cannot change.
    [Throws=TransitionError]
    DoseSchedule update_schedule(i64 id, NewDoseSchedule schedule);

    [Throws=TransitionError]
    void set_schedule_active(i64 id, boolean active);

    [Throws=TransitionError]
    void set_schedule_next_due(i64 id, i64 next_due_at_ms);

    [Throws=TransitionError]
    void delete_schedule(i64 id);

    // Journal
    [Throws=TransitionError]
    JournalEntry add_journal_entry(NewJournalEntry entry);

    [Throws=TransitionError]
    sequence<JournalEntry> list_journal_entries(i64 offset, i64 limit);

    [Throws=TransitionError]
    JournalEntry? get_journal_entry(i64 id);

    [Throws=TransitionError]
    JournalEntry update_journal_entry(i64 id, NewJournalEntry entry);

    [Throws=TransitionError]
    void delete_journal_entry(i64 id);

    // Hormones
    [Throws=TransitionError]
    HormoneMeasurement add_hormone_measurement(NewHormoneMeasurement m);

    [Throws=TransitionError]
    sequence<HormoneMeasurement> list_hormone_measurements(string hormone, i64 offset, i64 limit);

    [Throws=TransitionError]
    sequence<string> distinct_hormones();

    [Throws=TransitionError]
    void delete_hormone_measurement(i64 id);

    // Photos
    [Throws=TransitionError]
    PhotoRecord add_photo_record(NewPhotoRecord photo);

    [Throws=TransitionError]
    sequence<PhotoRecord> list_photo_records(i64 offset, i64 limit);

    [Throws=TransitionError]
    void delete_photo_record(i64 id);

    // Voice clips
    [Throws=TransitionError]
    VoiceClip add_voice_clip(NewVoiceClip clip);

    [Throws=TransitionError]
    sequence<VoiceClip> list_voice_clips(i64 offset, i64 limit);

    [Throws=TransitionError]
    void delete_voice_clip(string id);

    // Metric definitions / values (shared customizable sliders)
    [Throws=TransitionError]
    sequence<MetricDefinition> list_metric_definitions(string domain, boolean include_archived);

    [Throws=TransitionError]
    MetricDefinition add_metric_definition(NewMetricDefinition def);

    [Throws=TransitionError]
    void update_metric_definition(i64 id, MetricDefinitionUpdate upd);

    [Throws=TransitionError]
    void archive_metric_definition(i64 id);

    [Throws=TransitionError]
    sequence<MetricValue> list_metric_values(string entry_domain, i64 entry_id);

    [Throws=TransitionError]
    void replace_metric_values(string entry_domain, i64 entry_id, sequence<MetricValue> values);

    // Bleeding / cycle tracking
    [Throws=TransitionError]
    BleedingEntry add_bleeding_entry(NewBleedingEntry entry);

    // Batch insert in one transaction — "cette semaine = règles" logged in
    // one action instead of one entry per day.
    [Throws=TransitionError]
    sequence<BleedingEntry> add_bleeding_entries(sequence<NewBleedingEntry> entries);

    [Throws=TransitionError]
    sequence<BleedingEntry> list_bleeding_entries(i64 offset, i64 limit);

    [Throws=TransitionError]
    BleedingEntry? get_bleeding_entry(i64 id);

    [Throws=TransitionError]
    BleedingEntry update_bleeding_entry(i64 id, NewBleedingEntry entry);

    [Throws=TransitionError]
    void delete_bleeding_entry(i64 id);

    // Dreams. night_ms is local midnight of the night the dream belongs to,
    // computed by the native side — the core cannot know the device's zone.
    [Throws=TransitionError]
    Dream add_dream(NewDream dream);
    [Throws=TransitionError]
    Dream? get_dream(i64 id);
    [Throws=TransitionError]
    sequence<Dream> list_dreams(i64? tag_id, i64 limit, i64 offset);
    [Throws=TransitionError]
    sequence<Dream> list_dreams_between(i64 from_ms, i64 to_ms);
    [Throws=TransitionError]
    Dream update_dream(i64 id, i64 night_ms, string title, string body, boolean lucid, i64 updated_ms);
    [Throws=TransitionError]
    void delete_dream(i64 id);
    [Throws=TransitionError]
    DreamTag add_dream_tag(string label, i64? color, i64 created_ms);
    [Throws=TransitionError]
    sequence<DreamTag> list_dream_tags();
    [Throws=TransitionError]
    void rename_dream_tag(i64 id, string label);
    [Throws=TransitionError]
    void delete_dream_tag(i64 id);
    [Throws=TransitionError]
    void tag_dream(i64 dream_id, i64 tag_id);
    [Throws=TransitionError]
    void untag_dream(i64 dream_id, i64 tag_id);
    [Throws=TransitionError]
    sequence<DreamTag> tags_for_dream(i64 dream_id);
    [Throws=TransitionError]
    DreamAudio add_dream_audio(NewDreamAudio audio);
    [Throws=TransitionError]
    sequence<DreamAudio> dream_audio(i64 dream_id);
    [Throws=TransitionError]
    void set_dream_transcript(i64 audio_id, string? transcript);
    [Throws=TransitionError]
    void delete_dream_audio(i64 audio_id);
    [Throws=TransitionError]
    sequence<string> all_dream_audio_paths();

    // Notes
    [Throws=TransitionError]
    Note add_note(NewNote note);
    [Throws=TransitionError]
    sequence<Note> list_notes(i64? folder_id);
    [Throws=TransitionError]
    Note? get_note(i64 id);
    [Throws=TransitionError]
    Note update_note(i64 id, string title, string body, i64 updated_ms);
    [Throws=TransitionError]
    void delete_note(i64 id);
    [Throws=TransitionError]
    void reorder_notes(sequence<i64> ids_in_order);
    [Throws=TransitionError]
    void move_note_to_folder(i64 id, i64? folder_id);
    [Throws=TransitionError]
    NoteFolder add_note_folder(NewNoteFolder folder);
    [Throws=TransitionError]
    sequence<NoteFolder> list_note_folders(i64? parent_id);
    [Throws=TransitionError]
    void rename_note_folder(i64 id, string name);
    [Throws=TransitionError]
    i64 note_folder_contents_count(i64 id);
    [Throws=TransitionError]
    sequence<string> note_image_paths_under_folder(i64 id);
    [Throws=TransitionError]
    void delete_note_folder(i64 id);
    [Throws=TransitionError]
    NoteImage add_note_image(NewNoteImage img);
    [Throws=TransitionError]
    sequence<NoteImage> note_images(i64 note_id);
    [Throws=TransitionError]
    sequence<string> all_note_image_paths();
    [Throws=TransitionError]
    void delete_note_image(i64 id);

    // Appointments / notes ("RDV")
    [Throws=TransitionError]
    Appointment add_appointment(NewAppointment appt);

    [Throws=TransitionError]
    sequence<Appointment> list_appointments(i64 offset, i64 limit);

    [Throws=TransitionError]
    Appointment? get_appointment(i64 id);

    [Throws=TransitionError]
    Appointment update_appointment(i64 id, NewAppointment appt);

    [Throws=TransitionError]
    void delete_appointment(i64 id);

    // In-vault key/value settings — the only encrypted store the apps have for
    // small values. Anything identifying goes here, never in the platforms'
    // own preference files.
    [Throws=TransitionError]
    string? get_setting(string key);

    [Throws=TransitionError]
    void set_setting(string key, string value);

    [Throws=TransitionError]
    void delete_setting(string key);

    // Generic blob encryption (photos, future audio).
    [Throws=TransitionError]
    bytes encrypt_blob(bytes plaintext);

    [Throws=TransitionError]
    bytes decrypt_blob(bytes ciphertext);

    // Backup
    [Throws=TransitionError]
    bytes export_encrypted(string passphrase);
};

dictionary HormoneMeasurement {
    i64 id;
    i64 at_ms;
    string hormone;
    f64 value;
    string unit;
    string? lab_name;
    string? notes;
};

dictionary NewHormoneMeasurement {
    i64 at_ms;
    string hormone;
    f64 value;
    string unit;
    string? lab_name;
    string? notes;
};

dictionary PhotoRecord {
    i64 id;
    i64 at_ms;
    string? category;
    string file_path;
    string? notes;
};

dictionary NewPhotoRecord {
    i64 at_ms;
    string? category;
    string file_path;
    string? notes;
};

dictionary VoiceClip {
    string id;
    i64 at_ms;
    i64 duration_ms;
    string file_path;
    i32? pitch_hz;
};

dictionary NewVoiceClip {
    string id;
    i64 at_ms;
    i64 duration_ms;
    string file_path;
    i32? pitch_hz;
};

dictionary JournalEntry {
    i64 id;
    i64 at_ms;
    u32? mood;
    u32? dysphoria;
    u32? euphoria;
    u32? libido;
    u32? energy;
    string? free_text;
    string? side_effects;
};

dictionary NewJournalEntry {
    i64 at_ms;
    u32? mood;
    u32? dysphoria;
    u32? euphoria;
    u32? libido;
    u32? energy;
    string? free_text;
    string? side_effects;
};

dictionary DoseSchedule {
    i64 id;
    i64 medication_id;
    string kind;
    u32? interval_minutes;
    u32? daily_hour;
    u32? daily_minute;
    u32? interval_days;
    i64 next_due_at_ms;
    boolean active;
    i64 created_at_ms;
    // Custom reminder text ("Aller chercher le traitement"). Shown in
    // notifications only when the content mode allows (never in GENERIC).
    string? label;
};

dictionary NewDoseSchedule {
    i64 medication_id;
    string kind;
    u32? interval_minutes;
    u32? daily_hour;
    u32? daily_minute;
    u32? interval_days;
    i64 next_due_at_ms;
    // Defaulted so existing call sites keep compiling unchanged.
    string? label = null;
};

// -- Customizable metric sliders (shared by journal + bleeding) --------------

dictionary MetricDefinition {
    i64 id;
    string domain;
    string metric_key;
    string label;
    string? emoji_left;
    string? emoji_right;
    u32 min_value;
    u32 max_value;
    i64 sort_order;
    boolean builtin;
    string? column_name;
    boolean enabled;
    boolean archived;
    i64 created_at_ms;
};

dictionary NewMetricDefinition {
    string domain;
    string metric_key;
    string label;
    string? emoji_left;
    string? emoji_right;
    u32 min_value;
    u32 max_value;
    i64 sort_order;
    i64 created_at_ms;
};

dictionary MetricDefinitionUpdate {
    string label;
    string? emoji_left;
    string? emoji_right;
    i64 sort_order;
    boolean enabled;
};

dictionary MetricValue {
    i64 metric_id;
    u32 value;
};

// -- Bleeding / cycle tracking -----------------------------------------------

dictionary BleedingEntry {
    i64 id;
    i64 at_ms;
    boolean? is_spotting;
    string? free_text;
};

dictionary NewBleedingEntry {
    i64 at_ms;
    boolean? is_spotting;
    string? free_text;
};

// -- Notes -------------------------------------------------------------------

dictionary Dream {
    i64 id;
    // The night this dream belongs to, NOT when it was written.
    i64 night_ms;
    string title;
    string body;
    boolean lucid;
    i64 created_ms;
    i64 updated_ms;
};

dictionary NewDream {
    i64 night_ms;
    string title;
    string body;
    boolean lucid;
    i64 created_ms;
    i64 updated_ms;
};

dictionary DreamTag {
    i64 id;
    string label;
    i64? color;
    i64 created_ms;
    // How many dreams carry this tag — recurrence is the point.
    i64 dream_count;
};

dictionary DreamAudio {
    i64 id;
    i64 dream_id;
    string file_path;
    i64 duration_ms;
    // On-device transcription only; null when none was produced.
    string? transcript;
    i64 position;
    i64 created_ms;
};

dictionary NewDreamAudio {
    i64 dream_id;
    string file_path;
    i64 duration_ms;
    string? transcript;
    i64 created_ms;
};

dictionary Note {
    i64 id;
    i64? folder_id;
    string title;
    string body;
    i64 sort_order;
    i64 created_ms;
    i64 updated_ms;
};

dictionary NewNote {
    i64? folder_id;
    string title;
    string body;
    i64 created_ms;
    i64 updated_ms;
};

dictionary NoteFolder {
    i64 id;
    string name;
    i64? parent_id;
    i64 sort_order;
    i64 created_ms;
};

dictionary NewNoteFolder {
    string name;
    i64? parent_id;
    i64 created_ms;
};

dictionary NoteImage {
    i64 id;
    i64 note_id;
    string file_path;
    i64 position;
};

dictionary NewNoteImage {
    i64 note_id;
    string file_path;
    i64 position;
};

// -- Appointments / notes ("RDV") --------------------------------------------

dictionary Appointment {
    i64 id;
    i64 at_ms;
    string? place;
    string? professional_name;
    string? professional_role;
    string? notes;
    string? todo;
    i64? reminder_at_ms;
};

dictionary NewAppointment {
    i64 at_ms;
    string? place;
    string? professional_name;
    string? professional_role;
    string? notes;
    string? todo;
    i64? reminder_at_ms;
};
