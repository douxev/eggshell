default_platform(:ios)

APP_IDENTIFIER = "com.douxev.eggshell"
SCHEME         = "Eggshell"
PROJECT        = "Eggshell/Eggshell.xcodeproj"   # generated by xcodegen, relative to apple/

platform :ios do
  # ---- helpers -------------------------------------------------------------
  def asc_api_key
    app_store_connect_api_key(
      key_id:                ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id:             ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content:           ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),  # base64 of the .p8
      is_key_content_base64: true,
      in_house:              false
    )
  end

  # ---- lanes ---------------------------------------------------------------

  desc "Generate the .xcodeproj from project.yml (XcodeGen must be installed)."
  lane :gen do
    sh("cd ../Eggshell && xcodegen generate")
  end

  desc "One-time: create the distribution cert + App Store profile in the match repo."
  desc "Run locally or in a guarded manual workflow — NOT in the normal beta pipeline."
  lane :certs do
    match(
      type:           "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly:       false,            # allow minting on first setup
      api_key:        asc_api_key
    )
  end

  desc "Build a signed app-store archive and upload it to TestFlight (internal)."
  lane :beta do
    setup_ci   # temp keychain so signing doesn't need an interactive login

    api_key = asc_api_key

    match(
      type:           "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly:       true,
      api_key:        api_key
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  PROJECT,
      team_id:               ENV["DEVELOPMENT_TEAM"],
      bundle_identifier:     APP_IDENTIFIER,
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{APP_IDENTIFIER}"
    )

    # Build number must be strictly increasing per (version) on TestFlight.
    next_build = latest_testflight_build_number(
      app_identifier:       APP_IDENTIFIER,
      version:              get_version_number(xcodeproj: PROJECT, target: SCHEME),
      initial_build_number: 0,
      api_key:              api_key
    ) + 1
    increment_build_number(xcodeproj: PROJECT, build_number: next_build)

    build_app(
      scheme:        SCHEME,
      project:       PROJECT,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
        }
      }
    )

    upload_to_testflight(
      api_key:                            api_key,
      skip_waiting_for_build_processing:  true,   # don't hold the runner
      distribute_external:                false,  # internal testers → no Beta App Review
      uses_non_exempt_encryption:         false   # mirrors ITSAppUsesNonExemptEncryption in Info.plist
    )
  end
end
