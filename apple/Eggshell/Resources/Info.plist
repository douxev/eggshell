<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>fr</string>
    <key>CFBundleDisplayName</key>
    <string>eggshell</string>
    <key>CFBundleName</key>
    <string>eggshell</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Localizations: French primary, English secondary (matches Android) -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>fr</string>
        <string>en</string>
    </array>

    <!-- Permission usage strings (shown in the iOS consent prompts) -->
    <key>NSFaceIDUsageDescription</key>
    <string>Déverrouiller votre coffre chiffré avec Face ID.</string>
    <key>NSCameraUsageDescription</key>
    <string>Prendre des photos de suivi, stockées chiffrées sur votre appareil.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Enregistrer des clips vocaux pour le suivi de la voix et des notes vocales dans le carnet de rêves, stockés chiffrés sur votre appareil.</string>
    <!--
      Required the moment SFSpeechRecognizer.requestAuthorization is called,
      and its absence is not a warning at runtime: the call terminates the
      process. ITMS-90683 rejected build 2.3.1 for it, which is the lucky
      outcome — the unlucky one is shipping and crashing on the first tap of
      « Transcrire ».

      The wording states the thing a reviewer cannot verify from the binary and
      a user has every reason to doubt: recognition is forced on-device
      (requiresOnDeviceRecognition = true) and there is no network fallback.
    -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Transcrire vos notes vocales de rêve en texte. La reconnaissance se fait uniquement sur votre appareil : aucun enregistrement n’est envoyé à un serveur.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Importer des photos de suivi depuis votre photothèque.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Enregistrer une photo déchiffrée dans votre photothèque.</string>
    <!-- Sport module. Both are asked for only after the user turned the
         feature on: the pedometer switch is what leads to the Motion prompt,
         and « Connecter » on the session editor to the Bluetooth one. -->
    <key>NSMotionUsageDescription</key>
    <string>Compter vos pas quotidiens avec le capteur de l’appareil. Rien ne quitte le téléphone.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Lire la fréquence cardiaque d’une ceinture, d’une bague ou de votre montre pendant une séance de sport. Rien ne quitte le téléphone.</string>
    <!-- Santé (HealthKit), read only. Asked for only when the user turns on
         « Importer depuis Santé (Apple) » in the Sport module — and that switch
         exists only when EggshellHealthKitEnabled below is true. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Lire vos entraînements, vos pas, votre fréquence cardiaque et vos distances de marche, de course et de vélo pour les ajouter à votre module Sport. Ces données restent sur votre téléphone, dans votre coffre chiffré, et ne sont jamais envoyées ailleurs.</string>
    <!-- HealthKit is parked: the App Store provisioning profile (fastlane
         match) has no HealthKit capability, and signing with the HealthKit
         entitlement would fail. While this is false, every HealthKit control
         stays hidden, so a build without the entitlement never offers a
         feature that cannot work. To turn it on, follow apple/HEALTHKIT-ENABLE.md. -->
    <key>EggshellHealthKitEnabled</key>
    <false/>
    <!-- bluetooth-central: a heart-rate sensor connected for a session keeps
         sending while the screen is locked — the phone is in a pocket for the
         whole workout, and without this mode iOS suspended the app and the
         readings stopped at the first screen lock. Nothing else runs in the
         background because of it: the app only holds a connection the user
         opened from the session editor. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
    </array>

    <!-- Export compliance.
         The app protects only its own local data with standard, published
         algorithms (AES-GCM, Argon2id, SQLCipher). That use qualifies for the
         export-compliance exemption, so we declare non-exempt = false to avoid
         the per-build "Missing Compliance" gate on TestFlight.
         ⚠ Confirm this determination for your jurisdiction; flip to <true/> and
         complete the App Store Connect self-classification if you add any
         non-standard cryptography. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
