<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app's entitlements since HealthKit was enabled on the App ID and
         the match profile regenerated (apple/HEALTHKIT-ENABLE.md). Same
         keychain group as Eggshell.entitlements, which stays as the fallback,
         plus read access to HealthKit. Signing with this file needs a profile
         that carries the HealthKit capability. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.douxev.eggshell</string>
    </array>
    <key>com.apple.developer.healthkit</key>
    <true/>
    <!-- Empty: no clinical health records, only the regular HealthKit types. -->
    <key>com.apple.developer.healthkit.access</key>
    <array/>
</dict>
</plist>
